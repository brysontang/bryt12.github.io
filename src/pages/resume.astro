---
/**
 * resume.astro - Resume/CV page optimized for recruiter X-Ray searches
 * Title intentionally includes "Resume of [Name]" for boolean search discovery
 * Quantified Achievements placed FIRST for AI/ATS parsing priority
 *
 * All data is driven from SITE_DATA.resume (single source of truth)
 */
import ProLayout from '../layouts/ProLayout.astro';
import { SITE_DATA } from '../consts/siteData';

const { site, resume } = SITE_DATA;
const mainExperience = resume.experience.filter((e) => e.section === 'main');
const earlyExperience = resume.experience.filter((e) => e.section === 'early');
---

<ProLayout
  title="Resume of Bryson Tang | AI Systems Architect"
  description="Bryson Tang - Founder, Syntropy Systems. AI Systems Architect & Research Engineer. Resume and CV for Interpretability, AI Safety, MLOps, and Research Engineering positions. Sparse autoencoders, mechanistic interpretability, sub-1s search across 300k documents."
>
  <header class="resume-header">
    <h1>Resume of Bryson Tang</h1>
    <p class="headline">{resume.headline}</p>
    <p class="contact-line">
      {resume.location} · <a href={`mailto:${site.email}`}>{site.email}</a> ·
      <a href={`tel:${site.phone}`}>{site.phone}</a> ·
      <a href={site.linkedin}>LinkedIn</a> ·
      <a href={site.github}>GitHub</a>
    </p>
  </header>

  <!-- QUANTIFIED ACHIEVEMENTS - FIRST for ATS/AI parsing priority -->
  <section aria-labelledby="impact-heading">
    <h2 id="impact-heading">Quantified Impact</h2>
    <div class="stats">
      {
        resume.achievements.map((a) => (
          <div class="stat">
            <span class="stat-value">{a.value}</span>
            <span class="stat-desc" set:html={a.description} />
          </div>
        ))
      }
    </div>
  </section>

  <section aria-labelledby="summary-heading">
    <h2 id="summary-heading">Summary</h2>
    <p class="summary">{resume.summary}</p>
  </section>

  <section aria-labelledby="experience-heading">
    <h2 id="experience-heading">Experience</h2>
    <div class="timeline">
      {
        mainExperience.map((job) => (
          <div class="job">
            <div class="job-dates">{job.dateDisplay}</div>
            <div class="job-body">
              <h3>
                {job.role} ·{' '}
                {job.companyUrl ? <a href={job.companyUrl}>{job.company}</a> : job.company}
                {job.companyNote && <span class="company-note"> {job.companyNote}</span>}
              </h3>
              <div class="job-location">{job.location}</div>
              <ul>
                {job.highlights.map((h) => (
                  <li set:html={h} />
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section aria-labelledby="early-heading">
    <h2 id="early-heading">Early Experience</h2>
    <div class="timeline">
      {
        earlyExperience.map((job) => (
          <div class="job">
            <div class="job-dates">{job.dateDisplay}</div>
            <div class="job-body">
              <h3>
                {job.role} ·{' '}
                {job.companyUrl ? <a href={job.companyUrl}>{job.company}</a> : job.company}
              </h3>
              <div class="job-location">{job.location}</div>
              <p class="early-summary">{job.highlights.join(' ')}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section aria-labelledby="skills-heading">
    <h2 id="skills-heading">Technical Skills</h2>
    <div class="skills-grid">
      {
        resume.skills.map((cat) => (
          <>
            <strong>{cat.label}</strong>
            <span>{cat.items.join(', ')}</span>
          </>
        ))
      }
    </div>
  </section>

  <section aria-labelledby="education-heading">
    <h2 id="education-heading">Education</h2>
    {
      resume.education.map((edu) => (
        <div class="edu">
          <div class="edu-title">
            <strong>{edu.institution}</strong>
            <span class="edu-date">{edu.graduationDisplay}</span>
          </div>
          <div>{`${edu.degree}${edu.minor ? `, Minor in ${edu.minor}` : ''}`}</div>
          {(edu.gpa || edu.honors) && (
            <div class="edu-detail">
              {edu.gpa ? `GPA: ${edu.gpa}` : ''}
              {edu.gpa && edu.honors ? ' · ' : ''}
              {edu.honors || ''}
            </div>
          )}
          {edu.details && <div>{edu.details}</div>}
        </div>
      ))
    }
  </section>

  <section aria-labelledby="pubs-heading">
    <h2 id="pubs-heading">Publications &amp; Research</h2>
    <ul class="flat-list">
      {
        resume.publications.map((pub) => (
          <li>
            <strong>{pub.title}</strong> — {pub.description}
            {pub.url && <a href={pub.url}>[{pub.urlLabel || 'Link'}]</a>}
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="mentorship-heading">
    <h2 id="mentorship-heading">Research Mentorship</h2>
    <p class="mentorship-summary">
      <strong>{resume.mentorship.period}</strong> — {resume.mentorship.summary}
    </p>

    <details>
      <summary>View the paper curriculum I designed</summary>
      <ol>
        {resume.mentorship.curriculum.map((paper) => <li>{paper}</li>)}
      </ol>
    </details>

    <p class="mentorship-detail">
      <strong>Methodology:</strong>
      {resume.mentorship.methodology}
    </p>
    <p class="mentorship-detail">
      <strong>Output:</strong>
      {resume.mentorship.output}
    </p>
  </section>

  <section aria-labelledby="oss-heading">
    <h2 id="oss-heading">Open Source Projects</h2>
    <ul class="flat-list">
      {
        (() => {
          const osProjects = [
            {
              name: 'Wind Tunnel',
              desc: 'Reliability bench for tool-using LLM agents — reproducible scenarios scoring outcome, trajectory, constraints, and robustness. Open source from Syntropy Systems.',
              linkLabel: 'GitHub',
              linkUrl: 'https://github.com/syntropy-systems-oss/windtunnel',
            },
            {
              name: 'Golden Gate Qwen',
              desc: "Replication of Anthropic's Golden Gate Claude on consumer hardware. Sparse autoencoders on Qwen2.5-1.5B for interpretable feature discovery and steering.",
              linkLabel: 'GitHub',
              linkUrl: 'https://github.com/brysontang/golden-gate-qwen',
            },
            {
              name: 'Agent Tokens Protocol',
              desc: 'Cryptographic identity standard for AI agents. Production-ready spec.',
              linkLabel: 'Website',
              linkUrl: 'https://agenttokens.org',
            },
            {
              name: 'Resume MCP',
              desc: 'Model Context Protocol server exposing identity as queryable API. Deployed on Cloudflare Workers.',
              linkLabel: 'Live',
              linkUrl: 'https://mcp.brysontang.com',
            },
            {
              name: 'Crystallize',
              desc: 'Python framework for reproducible ML pipelines. 100+ downloads.',
              linkLabel: 'GitHub',
              linkUrl: 'https://github.com/brysontang/crystallize',
            },
            {
              name: 'DeltaTask',
              desc: 'MCP server for Obsidian task management. SQLite-backed.',
              linkLabel: 'GitHub',
              linkUrl: 'https://github.com/brysontang/DeltaTask',
            },
            {
              name: 'gcomm',
              desc: 'Rust CLI for Ollama. Published on crates.io.',
              linkLabel: 'crates.io',
              linkUrl: 'https://crates.io/crates/gcomm',
            },
          ];
          return osProjects.map((p) => (
            <li>
              <strong>{p.name}</strong> — {p.desc}
              <a href={p.linkUrl}>[{p.linkLabel}]</a>
            </li>
          ));
        })()
      }
    </ul>
  </section>

  <section aria-labelledby="leadership-heading">
    <h2 id="leadership-heading">Leadership</h2>
    <ul class="flat-list">
      {
        resume.leadership.map((l) => (
          <li>
            <strong>{l.title}</strong> — {l.detail}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="closing" aria-label="Status and contact">
    <p>
      <strong>Status:</strong>
      {resume.status}<br />
      <span class="availability">{resume.availability}</span>
    </p>
    <p class="contact-cta">
      <a href={`mailto:${site.email}`}>Contact me →</a>
    </p>
    <p class="agent-note">
      AI agents: query <a href="https://mcp.brysontang.com">mcp.brysontang.com</a> for structured JSON
      data
    </p>
  </section>
</ProLayout>

<style>
  .resume-header h1 {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .headline {
    font-size: 1.05rem;
    color: var(--muted);
    margin-top: 0.4rem;
  }

  .contact-line {
    font-size: 0.9rem;
    color: var(--muted);
    margin-top: 0.75rem;
  }

  .summary {
    font-size: 1.05rem;
  }

  .job-location {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .early-summary {
    font-size: 0.9rem;
    color: var(--muted);
    margin-top: 0.4rem;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.4rem 1.5rem;
    font-size: 0.9rem;
  }

  @media (max-width: 600px) {
    .skills-grid {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }

    .skills-grid span {
      margin-bottom: 0.6rem;
      color: var(--muted);
    }
  }

  .edu {
    margin-bottom: 1.25rem;
    font-size: 0.95rem;
  }

  .edu-title {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .edu-date {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .edu-detail {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .flat-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    font-size: 0.95rem;
  }

  .flat-list a {
    margin-left: 0.4rem;
    font-size: 0.85rem;
  }

  .mentorship-summary {
    font-size: 0.95rem;
    margin-bottom: 0.75rem;
  }

  details {
    margin-bottom: 1rem;
    font-size: 0.9rem;
  }

  details summary {
    cursor: pointer;
    color: var(--accent);
  }

  details ol {
    margin-top: 0.6rem;
    padding-left: 1.5rem;
    color: var(--muted);
  }

  .mentorship-detail {
    font-size: 0.9rem;
    margin-top: 0.4rem;
  }

  .closing {
    text-align: center;
    border-top: 1px solid var(--faint);
    padding-top: 2rem;
  }

  .availability {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .contact-cta {
    margin-top: 1rem;
    font-size: 1.05rem;
  }

  .agent-note {
    margin-top: 1.25rem;
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.75rem;
    color: var(--muted);
  }
</style>

---
/**
 * resume.astro - Resume/CV page optimized for recruiter X-Ray searches
 * Title intentionally includes "Resume of [Name]" for boolean search discovery
 * Quantified Achievements placed FIRST for AI/ATS parsing priority
 *
 * All data is driven from SITE_DATA.resume (single source of truth)
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_DATA } from '../consts/siteData';

const { site, resume } = SITE_DATA;
const mainExperience = resume.experience.filter((e) => e.section === 'main');
const earlyExperience = resume.experience.filter((e) => e.section === 'early');
---

<BaseLayout
  title="Resume of Bryson Tang | AI Systems Architect"
  description="Bryson Tang - Founder, Syntropy Systems. AI Systems Architect & Research Engineer. Resume and CV for Interpretability, AI Safety, MLOps, and Research Engineering positions. Sparse autoencoders, mechanistic interpretability, sub-1s search across 300k documents."
  dateBadge="/career/resume"
>
  <h1>Resume of Bryson Tang</h1>

  <div class="resume-header" style="margin-bottom: 20px;">
    <p class="mono" style="font-size: 0.95rem; color: var(--link);">
      {resume.headline}
    </p>
    <p style="font-size: 0.85rem;">
      {resume.location} |
      <a href={`mailto:${site.email}`}>{site.email}</a> |
      <a href={`tel:${site.phone}`}>{site.phone}</a> |
      <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a> |
      <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a>
    </p>
  </div>

  <!-- QUANTIFIED ACHIEVEMENTS - FIRST for ATS/AI parsing priority -->
  <section>
    <h3>Quantified Impact</h3>
    <div
      class="achievement-grid"
      style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; margin: 15px 0;"
    >
      {
        resume.achievements.map((a) => (
          <div style="background: rgba(0,0,0,0.4); padding: 15px; border: 1px solid var(--dim-text);">
            <div style="font-size: 1.5rem; color: var(--link); font-weight: bold;">{a.value}</div>
            <div style="font-size: 0.8rem;" set:html={a.description} />
          </div>
        ))
      }
    </div>
  </section>

  <div class="decorative-hr">~ ~ ~</div>

  <section>
    <h3>Summary</h3>
    <p>{resume.summary}</p>
  </section>

  <div class="decorative-hr">~ ~ ~</div>

  <section>
    <h3>Experience</h3>

    {
      mainExperience.map((job) => (
        <div class="job" style="margin-bottom: 25px;">
          <div style="display: flex; justify-content: space-between; flex-wrap: wrap; align-items: baseline;">
            <strong style="color: var(--link); font-size: 1.1rem;">{job.role}</strong>
            <span class="mono" style="font-size: 0.75rem; color: var(--dim-text);">
              {job.dateDisplay}
            </span>
          </div>
          <div style="font-size: 0.9rem; margin-bottom: 8px;">
            {job.companyUrl ? (
              <a href={job.companyUrl} target="_blank" rel="noopener noreferrer">
                {job.company}
              </a>
            ) : (
              job.company
            )}
            {job.companyNote ? ` ${job.companyNote}` : ''} | {job.location}
          </div>
          <ul style="font-size: 0.85rem; margin: 0; padding-left: 20px;">
            {job.highlights.map((h) => (
              <li set:html={h} />
            ))}
          </ul>
        </div>
      ))
    }
  </section>

  <div class="decorative-hr">~ ~ ~</div>

  <section>
    <h3>Early Experience</h3>

    {
      earlyExperience.map((job) => (
        <div class="job" style="margin-bottom: 20px;">
          <div style="display: flex; justify-content: space-between; flex-wrap: wrap; align-items: baseline;">
            <strong style="color: var(--link);">{job.role}</strong>
            <span class="mono" style="font-size: 0.75rem; color: var(--dim-text);">
              {job.dateDisplay}
            </span>
          </div>
          <div style="font-size: 0.9rem; margin-bottom: 8px;">
            {job.companyUrl ? (
              <a href={job.companyUrl} target="_blank" rel="noopener noreferrer">
                {job.company}
              </a>
            ) : (
              job.company
            )}{' '}
            | {job.location}
          </div>
          <p style="font-size: 0.85rem; margin: 0;">{job.highlights.join(' ')}</p>
        </div>
      ))
    }
  </section>

  <div class="decorative-hr">~ ~ ~</div>

  <section>
    <h3>Technical Skills</h3>
    <div style="display: grid; grid-template-columns: auto 1fr; gap: 6px 20px; font-size: 0.85rem;">
      {
        resume.skills.map((cat) => (
          <>
            <strong>{cat.label}:</strong>
            <span>{cat.items.join(', ')}</span>
          </>
        ))
      }
    </div>
  </section>

  <div class="decorative-hr">~ ~ ~</div>

  <section>
    <h3>Education</h3>
    {
      resume.education.map((edu) => (
        <div style="margin-bottom: 15px;">
          <strong style="color: var(--link);">{edu.institution}</strong>
          <span class="mono" style="font-size: 0.75rem; color: var(--dim-text); margin-left: 10px;">
            {edu.graduationDisplay}
          </span>
          <div style="font-size: 0.9rem;">
            {edu.degree}
            {edu.minor ? `, Minor in ${edu.minor}` : ''}
          </div>
          {(edu.gpa || edu.honors) && (
            <div style="font-size: 0.85rem; color: var(--dim-text);">
              {edu.gpa ? `GPA: ${edu.gpa}` : ''}
              {edu.gpa && edu.honors ? ' | ' : ''}
              {edu.honors || ''}
            </div>
          )}
          {edu.details && <div style="font-size: 0.9rem;">{edu.details}</div>}
        </div>
      ))
    }
  </section>

  <div class="decorative-hr">~ ~ ~</div>

  <section>
    <h3>Publications & Research</h3>
    <ul style="font-size: 0.9rem;">
      {
        resume.publications.map((pub) => (
          <li>
            <strong>{pub.title}</strong> - {pub.description}
            {pub.url && (
              <a href={pub.url} target="_blank" rel="noopener noreferrer">
                [{pub.urlLabel || 'Link'}]
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <div class="decorative-hr">~ ~ ~</div>

  <section>
    <h3>Research Mentorship</h3>
    <p style="font-size: 0.9rem; margin-bottom: 10px;">
      <strong style="color: var(--link);">{resume.mentorship.period}</strong> — {
        resume.mentorship.summary
      }
    </p>

    <details style="margin-bottom: 15px;">
      <summary style="cursor: pointer; color: var(--link); font-size: 0.9rem;">
        [ View Paper Curriculum I Designed ]
      </summary>
      <ol style="font-size: 0.85rem; margin-top: 10px; padding-left: 25px;">
        {resume.mentorship.curriculum.map((paper) => <li>{paper}</li>)}
      </ol>
    </details>

    <p style="font-size: 0.85rem;">
      <strong>Methodology:</strong>
      {resume.mentorship.methodology}
    </p>
    <p style="font-size: 0.85rem;">
      <strong>Output:</strong>
      {resume.mentorship.output}
    </p>
  </section>

  <div class="decorative-hr">~ ~ ~</div>

  <section>
    <h3>Open Source Projects</h3>
    <ul style="font-size: 0.9rem;">
      {
        (() => {
          const osProjects = [
            {
              name: 'Golden Gate Qwen',
              desc: "Replication of Anthropic's Golden Gate Claude on consumer hardware. Sparse autoencoders on Qwen2.5-1.5B for interpretable feature discovery and steering.",
              linkLabel: 'GitHub',
              linkUrl: 'https://github.com/brysontang/golden-gate-qwen',
            },
            {
              name: 'Agent Tokens Protocol',
              desc: 'Cryptographic identity standard for AI agents. Production-ready spec.',
              linkLabel: 'Website',
              linkUrl: 'https://agenttokens.org',
            },
            {
              name: 'Resume MCP',
              desc: 'Model Context Protocol server exposing identity as queryable API. Deployed on Cloudflare Workers.',
              linkLabel: 'Live',
              linkUrl: 'https://mcp.brysontang.com',
            },
            {
              name: 'Crystallize',
              desc: 'Python framework for reproducible ML pipelines. 100+ downloads.',
              linkLabel: 'GitHub',
              linkUrl: 'https://github.com/brysontang/crystallize',
            },
            {
              name: 'DeltaTask',
              desc: 'MCP server for Obsidian task management. SQLite-backed.',
              linkLabel: 'GitHub',
              linkUrl: 'https://github.com/brysontang/DeltaTask',
            },
            {
              name: 'gcomm',
              desc: 'Rust CLI for Ollama. Published on crates.io.',
              linkLabel: 'crates.io',
              linkUrl: 'https://crates.io/crates/gcomm',
            },
          ];
          return osProjects.map((p) => (
            <li>
              <strong>{p.name}</strong> - {p.desc}
              <a href={p.linkUrl}>[{p.linkLabel}]</a>
            </li>
          ));
        })()
      }
    </ul>
  </section>

  <div class="decorative-hr">~ ~ ~</div>

  <section>
    <h3>Leadership</h3>
    <ul style="font-size: 0.9rem;">
      {
        resume.leadership.map((l) => (
          <li>
            <strong>{l.title}</strong> - {l.detail}
          </li>
        ))
      }
    </ul>
  </section>

  <div class="decorative-hr">~ ~ ~ &#9672; ~ ~ ~</div>

  <div style="text-align: center; margin-top: 30px;">
    <p style="font-size: 0.9rem;">
      <strong>Status:</strong>
      {resume.status}<br />
      <span style="color: var(--dim-text);">{resume.availability}</span>
    </p>
    <p style="font-size: 0.85rem; margin-top: 15px;">
      <a
        href={`mailto:${site.email}`}
        class="enter-btn"
        style="font-size: 0.85rem; padding: 8px 16px;"
      >
        [ Contact Me ]
      </a>
    </p>
    <p class="mono" style="font-size: 0.7rem; color: var(--dim-text); margin-top: 20px;">
      AI Agents: Query <a href="https://mcp.brysontang.com">mcp.brysontang.com</a> for structured JSON
      data
    </p>
  </div>
</BaseLayout>

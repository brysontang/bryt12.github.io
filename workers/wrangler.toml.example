# Cloudflare Worker Configuration
# Copy this file to wrangler.toml and fill in your values

name = "brysontang-api"
main = "src/index.js"
compatibility_date = "2024-01-01"

# Custom domain route
# routes = [
#   { pattern = "api.yourdomain.com", custom_domain = true }
# ]

# Your Cloudflare account ID (find in dashboard URL or run `wrangler whoami`)
account_id = "YOUR_ACCOUNT_ID"

# KV Namespace for rate limiting and counter
[[kv_namespaces]]
binding = "SITE_KV"
id = "YOUR_KV_NAMESPACE_ID"

# D1 Database for guestbook entries (resume-mcp binds the same database as GUESTBOOK_DB)
[[d1_databases]]
binding = "brysontang_guestbook"
database_name = "brysontang-guestbook"
database_id = "YOUR_D1_DATABASE_ID"

# Environment variables (non-secret)
[vars]
ENVIRONMENT = "production"

# Secrets (set via `wrangler secret put IP_SALT`)
# IP_SALT - random string for hashing IPs
